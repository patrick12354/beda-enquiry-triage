# Optional. With no key the system runs on a deterministic local stand-in:
# no network, no cost, and the same decisions every time. Set a key only if you
# want the classification and extraction steps to run against a hosted model.
#
# Nothing else changes. The gate, the grounding check, the reconciliation, the
# identity resolution and the approval boundary are all deterministic code and
# never call out.
OPENROUTER_API_KEY=

# Optional. Defaults to 5173.
PORT=5173
